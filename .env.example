# Server
NODE_ENV=development
PORT=3000
# Local / Expo Go: * is fine. Production: comma-separated origins only (no *).
CORS_ORIGIN=*

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local-only: in-memory login/register when Supabase is unavailable
# DEV_MOCK_AUTH=true

# OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_TRANSCRIPTION_MODEL=whisper-1
# Extracción JSON: gpt-4.1-nano (~5x más barato que gpt-4o-mini)
OPENAI_EXTRACTION_MODEL=gpt-4.1-nano
OPENAI_CHAT_MODEL=gpt-4.1-nano

# Storage
AUDIO_STORAGE_BUCKET=audio-uploads
UPLOAD_MAX_FILE_SIZE_MB=25

# Worker
WORKER_POLL_INTERVAL_MS=500
WORKER_MAX_RETRIES=3
# How often to send due account notifications to all user devices (Expo Push)
NOTIFICATION_POLL_INTERVAL_MS=5000

# Timezone for date parsing from audio (Ecuador)
DEFAULT_TIMEZONE=America/Guayaquil
